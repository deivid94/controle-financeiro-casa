generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Prioridade {
  ESSENCIAL
  IMPORTANTE
  NORMAL
}

enum TipoConta {
  RECORRENTE_VARIAVEL
  RECORRENTE_FIXA
  PARCELADA
}

enum StatusLancamento {
  PENDENTE
  PAGA
  CANCELADA
}

model Conta {
  id                String       @id @default(cuid())
  nome              String
  tipo              TipoConta
  prioridade        Prioridade
  diaVencimento     Int
  valorCentavos     Int?
  totalParcelas     Int?
  primeiraParcela   String? // AAAA-MM
  inicioCompetencia String // mês de cadastro (AAAA-MM, fuso SP)
  linkSegundaVia    String?
  ativa             Boolean      @default(true)
  lancamentos       Lancamento[]
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
}

model Lancamento {
  id              String           @id @default(cuid())
  contaId         String?
  conta           Conta?           @relation(fields: [contaId], references: [id])
  nome            String
  prioridade      Prioridade
  competencia     String // AAAA-MM
  vencimento      String // AAAA-MM-DD
  valorCentavos   Int?
  numeroParcela   Int?
  status          StatusLancamento @default(PENDENTE)
  pagoEm          DateTime?
  pagoPorId       String?
  codigoPagamento String?
  observacao      String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([contaId, competencia])
  @@index([competencia, status])
}
